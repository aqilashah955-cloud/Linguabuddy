// LinguaBuddy — Firebase Storage security rules (rules_version '2').
// Paste into the Firebase console: Storage → Rules → Publish.
//
// Data model:
//   writing/{uid}/{docId}.jpg   "My Work" photos of handwritten work
//   profile-photos/{uid}.jpg   student profile photos
//
// Privacy: each student writes only their own files. Profile photos are
// readable by any signed-in user (teachers see them in the class roster);
// "My Work" photos stay private to the owning student and the admin.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == "nizarsyed74@gmail.com";
    }

    match /writing/{uid}/{file} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /profile-photos/{uid}.jpg {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }
  }
}
