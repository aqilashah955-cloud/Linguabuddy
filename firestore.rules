// LinguaBuddy — Firestore security rules (rules_version '2').
// Paste into the Firebase console: Firestore Database → Rules → Publish.
//
// Data model:
//   users/{uid}                  profile + learning state mirror
//   loginIds/{loginId}           {email, uid} — login-ID → email resolution
//   classes/{id}                 {name, teacherId, students[{uid,name,loginId}], studentIds[]}
//   assignments/{id}             {classId, title, sloIds[], count, dueAt, teacherId}
//   submissions/{id}             {studentId, classId?, assignmentId?, answers, score, total, pct, perSlo, teacherIds[]}
//   vocabulary/{uid}/words/{w}   saved words per student
//   readingProgress/{uid}/{rid}  story completion per student
//   writingUploads/{id}          My Work photo uploads: {studentId, title, type,
//                                photoUrl (Storage URL only — never bytes),
//                                text, feedbackCount, teacherIds[], createdAt}
//
// Curated content (SLOs, stories, words) ships as bundled JS data modules
// and is NEVER read from Firestore — zero read costs, works offline.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == "REPLACE_WITH_OWNER_EMAIL";
    }

    // ---- user profiles: owners only (admin: full read).
    // Role is set at signup (student/teacher); afterwards only the admin
    // may change it, so a student can never promote themselves.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ["student", "teacher"];
      allow update: if signedIn() && request.auth.uid == uid
        && (isAdmin() || request.resource.data.role == resource.data.role);
      allow delete: if false;
    }

    // ---- login-ID directory: anyone may resolve an ID to an email
    // (needed on the login screen); only the owning signed-in user may
    // create their own mapping, and mappings are immutable afterwards.
    match /loginIds/{loginId} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/loginIds/$(loginId))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(["email", "uid"]);
      allow update, delete: if false;
    }

    // ---- classes (teacher dashboard, Part 2) ----
    match /classes/{id} {
      allow read: if signedIn() && (
        resource.data.teacherId == request.auth.uid ||
        request.auth.uid in resource.data.studentIds || isAdmin());
      allow create: if signedIn()
        && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if signedIn() && (
        resource.data.teacherId == request.auth.uid || isAdmin());
    }

    function teacherOfClass(classId) {
      return classId != null
        && exists(/databases/$(database)/documents/classes/$(classId))
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }

    // ---- assignments (Part 2) ----
    match /assignments/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (
        isAdmin() || teacherOfClass(request.resource.data.classId));
      allow delete: if signedIn() && (
        isAdmin() || teacherOfClass(resource.data.classId));
    }

    // ---- submissions: students write own + read own; a class teacher
    // reads submissions whose teacherIds include them (attached at submit
    // time); admin reads all.
    match /submissions/{id} {
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid ||
        request.auth.uid in resource.data.get("teacherIds", []) ||
        isAdmin());
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- vocabulary: private to each student ----
    match /vocabulary/{uid}/words/{word} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---- reading progress: private to each student ----
    match /readingProgress/{uid}/{rid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---- writingUploads: "My Work" photo uploads of handwritten work.
    // Students write own + read own; a class teacher reads uploads whose
    // teacherIds include them (attached at upload time, same pattern as
    // submissions); admin reads all. The Firestore doc holds ONLY the
    // Firebase Storage download URL — photo bytes live in Storage.
    match /writingUploads/{id} {
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid ||
        request.auth.uid in resource.data.get("teacherIds", []) ||
        isAdmin());
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
